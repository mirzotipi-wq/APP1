+#if DEBUG
+/// UI-test diagnostics deliberately receive no draft, label, selection, input
+/// fragment, or text length. Unknown identifiers are reduced to a fixed token.
+/// A cap marker makes a truncated trace distinguishable from absent events.
+struct StudioTextFieldInputTrace {
+    static let maximumEvents = 128
+    static func isEnabled(arguments: [String]) -> Bool { arguments.contains("-ui-testing") }
+    private let instance = UUID()
+    private var sequence = 0
+    private var shouldChanges = 0
+    private var editingChanges = 0
+    private var bindingWrites = 0
+    private var replacements = 0
+
+    mutating func record(_ event: StaticString, identifier: String?, lifecycle: UUID,
+                         gate: StaticString, firstResponder: Bool, inWindow: Bool, enabled: Bool,
+                         marked: Bool, synchronizingFocus: Bool) -> String? {
+        guard sequence < Self.maximumEvents else { return nil }
+        sequence += 1
+        switch event.description {
+        case "should-change": shouldChanges += 1
+        case "editing-changed": editingChanges += 1
+        case "binding-write": bindingWrites += 1
+        case "replace-text": replacements += 1
+        default: break
+        }
+        let control: String
+        switch identifier {
+        case "roomWidth", "precisionValue", "projectNameInput": control = identifier ?? "other"
+        default: control = "other"
+        }
+        return "StudioTextFieldTrace instance=\(instance) lifecycle=\(lifecycle) control=\(control) " +
+            "sequence=\(sequence) event=\(event) gate=\(gate) " +
+            "shouldChanges=\(shouldChanges) editingChanges=\(editingChanges) " +
+            "bindingWrites=\(bindingWrites) replacements=\(replacements) " +
+            "firstResponder=\(firstResponder) inWindow=\(inWindow) enabled=\(enabled) " +
+            "marked=\(marked) synchronizingFocus=\(synchronizingFocus) " +
+            "limitReached=\(sequence == Self.maximumEvents)"
     }
 }
+#endif

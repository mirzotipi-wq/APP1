+import Foundation
+import Dispatch
+
+@main struct GrazingStudyProbe {
+    static func scene(intensity: Double = 1000) -> LightingScene {
+        let receiver = Position(x: 0, y: 0, z: 0.25)
+        let light = StudioLight(name: "Grazing area", position: .init(x: 0, y: 0, z: 0), candela: intensity, kelvin: 5600,
+                                optics: .init(kind: .rectangle, aimTarget: receiver, widthMeters: 1, heightMeters: 0.6))
+        return .init(subject: receiver, camera: .init(x: 0, y: 0, z: 3), lights: [light])
+    }
+    // Independent vertical-slice Simpson reference, not production clipping.
+    static func reference(cut: Double, slope: Double) -> Double {
+        let depth = 0.25, width = 1.0, height = 0.6, count = 160
+        let length = sqrt(1 + slope * slope + cut * cut / (depth * depth))
+        let x0 = max(-width / 2, cut - slope * height / 2), x1 = width / 2
+        guard x0 < x1 else { return 0 }
+        let dx = (x1 - x0) / Double(count)
+        func weight(_ i: Int) -> Double { i == 0 || i == count ? 1 : i % 2 == 0 ? 2 : 4 }
+        var sum = 0.0
+        for i in 0...count {
+            let x = x0 + Double(i) * dx
+            let y0 = slope == 0 ? -height / 2 : max(-height / 2, (cut - x) / slope), y1 = height / 2
+            if y0 >= y1 { continue }
+            let dy = (y1 - y0) / Double(count)
+            var slice = 0.0
+            for j in 0...count {
+                let y = y0 + Double(j) * dy
+                let r2 = x * x + y * y + depth * depth
+                slice += weight(j) * depth * max(0, (x + slope * y - cut) / length) / (r2 * r2)
+            }
+            sum += weight(i) * slice * dy / 3
+        }
+        return sum * dx / 3 * 1000 / (width * height)
+    }
+    static func main() throws {
+        let receiver = Position(x: 0, y: 0, z: 0.25)
+        if CommandLine.arguments.contains("--bench") {
+            for quality in [StudyQuality.interactive, .reference] {
+                let lighting = try StudyLighting(scene: scene(), quality: quality)
+                for (name, cut, slope) in [("full",-1.0,0.0),("half",0.0,0.0),("strip",0.499,0.0),("corner",0.799,1.0)] {
+                    let n = UnitDirection(x: 1, y: slope, z: cut / 0.25)!
+                    var times: [Double] = [], checksum = 0.0
+                    for run in 0..<7 {
+                        let start = DispatchTime.now().uptimeNanoseconds
+                        for _ in 0..<2000 {
+                            let signal = try lighting.evaluate(receiver: receiver, normal: n, view: n,
+                                                               material: .dielectric(reflectance: 0.18, roughness: 0.32, f0: 0.04))
+                            checksum += signal.visibleLux + signal.unoccludedLux + signal.signalXYZ.x + signal.signalXYZ.y + signal.signalXYZ.z
+                        }
+                        if run > 0 { times.append(Double(DispatchTime.now().uptimeNanoseconds - start) / 1e6) }
+                    }
+                    print("BENCH \(quality) \(name) samples_ms=\(times) checksum=\(checksum)")
+                }
+            }
+            return
+        }
+        var failures = 0
+        for quality in [StudyQuality.interactive, .reference] {
+            let lighting = try StudyLighting(scene: scene(), quality: quality)
+            for (slope, cuts) in [(0.0,[0.45,0.48,0.499,0.49999]),(1.0,[0.6,0.79,0.799,0.79999])] {
+                for cut in cuts {
+                    let n = UnitDirection(x: 1, y: slope, z: cut / 0.25)!
+                    let actual = try lighting.evaluate(receiver: receiver, normal: n, view: n, material: .diffuse(reflectance: 1)).visibleLux
+                    let expected = reference(cut: cut, slope: slope)
+                    let error = abs(actual - expected) / expected
+                    let pass = actual > 0 && error < 0.002
+                    if !pass { failures += 1 }
+                    print("CASE \(quality) slope=\(slope) cut=\(cut) actual=\(actual) expected=\(expected) relative_error=\(error) \(pass ? "PASS" : "FAIL")")
+                }
+            }
+        }
+        print("GRAZING_REGRESSIONS 16 cases; \(failures) failed")
+        if failures != 0 { exit(1) }
+    }
+}

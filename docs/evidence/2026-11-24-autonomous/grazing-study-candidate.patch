+/// Affine receiver incidence over a sample cell's local [-1, 1] square.
+/// Coefficients are unnormalized distances; only their sign clips the domain.
+struct StudyAreaCellPlane {
+    let x: Double
+    let y: Double
+    let center: Double
+    var radius: Double { abs(x) + abs(y) }
+    func at(_ p: SIMD2<Double>) -> Double { center + x * p.x + y * p.y }
+}
+
+/// Bounded quadrature for a cell cut by the shading hemisphere and, for a
+/// mannequin, the actual geometric hemisphere. No visibility is inferred here:
+/// the caller traces every returned source position through its usual path.
+enum StudyAreaCellQuadrature {
+    static func forEach(normal: StudyAreaCellPlane, geometric: StudyAreaCellPlane? = nil,
+                        _ body: (SIMD2<Double>, Double) throws -> Void) rethrows {
+        // Clipping a quadrilateral by at most two half-planes yields at most
+        // six vertices. Two fixed eight-element buffers avoid per-cell heaps.
+        try withUnsafeTemporaryAllocation(of: SIMD2<Double>.self, capacity: 16) { storage in
+            var input = UnsafeMutableBufferPointer(start: storage.baseAddress!, count: 8)
+            var output = UnsafeMutableBufferPointer(start: storage.baseAddress! + 8, count: 8)
+            input[0] = .init(-1, -1); input[1] = .init(1, -1)
+            input[2] = .init(1, 1); input[3] = .init(-1, 1)
+            var count = clip(input, count: 4, plane: normal, into: output)
+            swap(&input, &output)
+            if let geometric, count >= 3 {
+                count = clip(input, count: count, plane: geometric, into: output)
+                swap(&input, &output)
+            }
+            guard count >= 3 else { return }
+            let a = input[0]
+            for index in 1..<(count - 1) {
+                let b = input[index], c = input[index + 1]
+                let ab = b - a, ac = c - a
+                // Triangle area / cell area / three equal quadrature weights.
+                let weight = abs(ab.x * ac.y - ab.y * ac.x) / 24
+                guard weight > 0 else { continue }
+                // Degree-two triangle rule. Positive interior points and exact
+                // area weights retain representable illuminated regions narrower than a cell.
+                try body((a * 4 + b + c) / 6, weight)
+                try body((b * 4 + a + c) / 6, weight)
+                try body((c * 4 + a + b) / 6, weight)
+            }
+        }
+    }
+
+    private static func clip(_ input: UnsafeMutableBufferPointer<SIMD2<Double>>, count: Int,
+                             plane: StudyAreaCellPlane,
+                             into output: UnsafeMutableBufferPointer<SIMD2<Double>>) -> Int {
+        guard count > 0 else { return 0 }
+        var previous = input[count - 1], previousDistance = plane.at(input[count - 1])
+        var written = 0
+        for index in 0..<count {
+            let current = input[index], distance = plane.at(current)
+            if (previousDistance > 0) != (distance > 0) {
+                let t = previousDistance / (previousDistance - distance)
+                output[written] = previous + (current - previous) * t
+                written += 1
+            }
+            if distance > 0 {
+                output[written] = current
+                written += 1
+            }
+            previous = current; previousDistance = distance
+        }
+        return written
+    }
+}

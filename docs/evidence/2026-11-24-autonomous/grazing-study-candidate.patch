+
+// A square clipped against affine receiver incidence has at most five vertices.
+// Coordinates are local to one cell; its total uncut area is four.
+inline uint kfClipStudyCell(float center, float nx, float ny, KF_THREAD float3 *clipped) {
+    const float3 square[4] = {float3(-1.0f,-1.0f,0.0f), float3(1.0f,-1.0f,0.0f),
+                              float3(1.0f,1.0f,0.0f), float3(-1.0f,1.0f,0.0f)};
+    float3 previous = square[3];
+    float previousDistance = center + nx*previous.x + ny*previous.y;
+    uint count = 0;
+    for (uint i=0; i<4; ++i) {
+        const float3 current = square[i];
+        const float distance = center + nx*current.x + ny*current.y;
+        if ((previousDistance > 0.0f) != (distance > 0.0f)) {
+            const float t = previousDistance/(previousDistance-distance);
+            clipped[count++] = previous + (current-previous)*t;
+        }
+        if (distance > 0.0f) clipped[count++] = current;
+        previous = current; previousDistance = distance;
+    }
+    return count;
+}

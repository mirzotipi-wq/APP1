+import Foundation
+import XCTest
+@testable import LightingCore
+
+final class StudyGrazingTests: XCTestCase {
+    private let receiver = Position(x: 0, y: 0, z: 0.25)
+    private func scene(candela: Double = 1000) -> LightingScene {
+        .init(subject: receiver, camera: .init(x: 0, y: 0, z: 3), lights: [
+            .init(name: "Grazing rectangle", position: .init(x: 0, y: 0, z: 0), candela: candela, kelvin: 5600,
+                  optics: .init(kind: .rectangle, aimTarget: receiver, widthMeters: 1, heightMeters: 0.6))
+        ])
+    }
+    private func normal(cut: Double, slope: Double = 0) -> UnitDirection {
+        UnitDirection(x: 1, y: slope, z: cut / 0.25)!
+    }
+    private func signal(_ lighting: StudyLighting, cut: Double, slope: Double = 0) throws -> StudySurfaceSignal {
+        let n = normal(cut: cut, slope: slope)
+        return try lighting.evaluate(receiver: receiver, normal: n, view: n, material: .diffuse(reflectance: 1))
+    }
+
+    // Independent Simpson integration over exact vertical slices. This shares
+    // neither production polygon clipping nor its triangle quadrature rule.
+    private func reference(cut: Double, slope: Double) -> Double {
+        let count = 160, depth = 0.25, width = 1.0, height = 0.6
+        let length = sqrt(1 + slope * slope + cut * cut / (depth * depth))
+        let x0 = max(-width / 2, cut - slope * height / 2), x1 = width / 2
+        guard x0 < x1 else { return 0 }
+        let dx = (x1 - x0) / Double(count)
+        func weight(_ i: Int) -> Double { i == 0 || i == count ? 1 : i % 2 == 0 ? 2 : 4 }
+        var sum = 0.0
+        for i in 0...count {
+            let x = x0 + Double(i) * dx
+            let y0 = slope == 0 ? -height / 2 : max(-height / 2, (cut - x) / slope), y1 = height / 2
+            if y0 >= y1 { continue }
+            let dy = (y1 - y0) / Double(count)
+            var slice = 0.0
+            for j in 0...count {
+                let y = y0 + Double(j) * dy, r2 = x * x + y * y + depth * depth
+                slice += weight(j) * depth * max(0, (x + slope * y - cut) / length) / (r2 * r2)
+            }
+            sum += weight(i) * slice * dy / 3
+        }
+        return sum * dx / 3 * 1000 / (width * height)
+    }

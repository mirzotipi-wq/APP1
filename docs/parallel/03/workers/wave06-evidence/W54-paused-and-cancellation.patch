+                return try self.output(10)
+            }, convert: { $0.rgba[0] }, publish: { completions.append($0) })
+        }
+        // This actor cannot start the task before cancellation and the await.
+        cancelledTask.cancel()
+        await cancelledTask.value
+        live.finish(.success(try output(9)))
+        await liveTask.value
+
+        XCTAssertEqual(cancelledRenders, 0)
+        XCTAssertEqual(completions.count, 1)
+        XCTAssertEqual(completions.first?.image, 9)
+        XCTAssertNil(completions.first?.message)
+    }

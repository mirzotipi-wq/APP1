    50	/// Right-handed world-space basis; right × up = emitting normal.
    51	/// Zero roll follows world up, with a deterministic basis at a vertical aim.
    52	/// Positive roll turns right toward up around the emitting normal (the right-hand rule).
    53	public struct EmitterFrame: Equatable, Sendable {
    54	    public let right: UnitDirection
    55	    public let up: UnitDirection
    56	    public let normal: UnitDirection
    57	
    58	    public init?(source: Position, target: Position, rollDegrees: Double = 0) {
    59	        guard source.isValid, target.isValid, rollDegrees.isFinite,
    60	              LightOptics.rollRange.contains(rollDegrees),
    61	              let n = UnitDirection(x: target.x - source.x, y: target.y - source.y, z: target.z - source.z) else { return nil }
    62	        let horizontal = hypot(n.x, n.z)
    63	        let r = horizontal > 1e-12
    64	            ? UnitDirection(x: n.z, y: 0, z: -n.x)
    65	            : UnitDirection(x: 1, y: 0, z: 0)
    66	        guard let r, let u = UnitDirection(x: n.y * r.z - n.z * r.y,
    67	                                           y: n.z * r.x - n.x * r.z,
    68	                                           z: n.x * r.y - n.y * r.x) else { return nil }
    69	        // Keep legacy sample coordinates exactly unchanged when no roll is requested.
    70	        if rollDegrees == 0 {
    71	            self.right = r; self.up = u; self.normal = n
    72	            return
    73	        }
    74	        // Exact cardinal coefficients keep mathematical wall/floor/ceiling
    75	        // contact from becoming a trigonometric overhang. Do not snap other
    76	        // angles or physical coordinates: real overhangs must remain outside.
    77	        let c: Double
    78	        let s: Double
    79	        switch rollDegrees {
    80	        case 90: c = 0; s = 1
    81	        case -90: c = 0; s = -1
    82	        case -180, 180: c = -1; s = 0
    83	        default:
    84	            let radians = rollDegrees * .pi / 180
    85	            c = cos(radians); s = sin(radians)
    86	        }
    87	        guard let rolledRight = UnitDirection(x: c * r.x + s * u.x,
    88	                                              y: c * r.y + s * u.y,
    89	                                              z: c * r.z + s * u.z),
    90	              let rolledUp = UnitDirection(x: -s * r.x + c * u.x,
    91	                                           y: -s * r.y + c * u.y,
    92	                                           z: -s * r.z + c * u.z) else { return nil }
    93	        self.right = rolledRight; self.up = rolledUp; self.normal = n
    94	    }
    95	}
